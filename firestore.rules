rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla de ayuda: verificar si es barbero autenticado
    function isAdmin() {
      return request.auth != null;
    }

    // Colección 1: Slots Públicos (Zero-Leak de datos de clientes)
    // Solo contiene: date, startMinutes, endMinutes, status, serviceDuration
    match /public_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.keys().hasAll(['date', 'startMinutes', 'endMinutes', 'status']) &&
        request.resource.data.status in ['occupied', 'blocked'] &&
        request.resource.data.date is string &&
        request.resource.data.startMinutes is int &&
        request.resource.data.endMinutes is int
      );
    }

    // Colección 2: Citas Completas (Privadas para el Barbero)
    match /appointments/{appointmentId} {
      // Clientes pueden crear su cita validando estructura básica
      allow create: if (
        request.resource.data.keys().hasAll([
          'folio', 'clientName', 'clientPhone', 'serviceId', 'serviceName',
          'price', 'durationMinutes', 'date', 'startTime', 'endTime',
          'startMinutes', 'endMinutes', 'status', 'source'
        ]) &&
        request.resource.data.clientPhone is string &&
        request.resource.data.clientPhone.size() == 10 &&
        request.resource.data.clientName is string &&
        request.resource.data.clientName.size() >= 2 &&
        request.resource.data.status in ['confirmed', 'completed', 'cancelled']
      ) || isAdmin();

      // Lectura, actualización y eliminación EXCLUSIVA para el barbero autenticado
      allow read, update, delete: if isAdmin();
    }

    // Locks diarios para concurrencia atómica
    match /daily_locks/{date} {
      allow read: if true;
      allow write: if true; // Controlado mediante atomic runTransaction en client SDK
    }

    // Colección 3: Configuración de Barbería y Servicios
    match /settings/{docId} {
      // Clientes pueden leer horarios de apertura y servicios ofrecidos
      allow read: if true;
      // Solo el barbero puede modificar horarios, precios o agregar servicios
      allow write: if isAdmin();
    }
  }
}
