rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla de ayuda: verificar si es barbero autenticado
    function isAdmin() {
      return request.auth != null;
    }

    // Colección 1: Slots Públicos (Zero-Leak de datos de clientes)
    // Solo contiene: date, startMinutes, endMinutes, status
    match /public_slots/{slotId} {
      allow read: if true;
      allow write, delete: if true;
    }

    // Colección 2: Citas Completas
    match /appointments/{appointmentId} {
      // Clientes pueden crear su cita validando estructura básica
      allow create: if (
        request.resource.data.keys().hasAll([
          'folio', 'clientName', 'clientPhone', 'serviceId', 'serviceName',
          'price', 'durationMinutes', 'date', 'startTime', 'endTime',
          'startMinutes', 'endMinutes', 'status', 'source'
        ]) &&
        request.resource.data.clientPhone is string &&
        request.resource.data.clientPhone.size() == 10 &&
        request.resource.data.clientName is string &&
        request.resource.data.clientName.size() >= 2 &&
        request.resource.data.status in ['confirmed', 'completed', 'cancelled']
      ) || isAdmin();

      // Cancelación permitida para cliente (únicamente cambiar status a 'cancelled') o control total para el barbero
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled'
      );

      // Lectura y eliminación de registro físico reservada al barbero autenticado
      allow read, delete: if isAdmin();
    }

    // Locks diarios para concurrencia atómica
    match /daily_locks/{date} {
      allow read, write: if true;
    }

    // Colección 3: Configuración de Barbería y Servicios
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
