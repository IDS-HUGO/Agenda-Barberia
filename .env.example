# ================================================================
# CONFIGURACIÓN DE FIREBASE (PLAN SPARK - 100% GRATUITO PERMANENTE)
# ================================================================
# Si dejas estas variables vacías, el sistema operará automáticamente
# en Modo Local Offline (IndexedDB / Dexie) para pruebas inmediatas.
#
# Para conectar tu base de datos en tiempo real en la nube:
# 1. Ve a https://console.firebase.google.com/ y crea un proyecto gratuito.
# 2. Agrega una app web (ícono </>) y copia los valores correspondientes:

VITE_FIREBASE_API_KEY=AIzaSyTuApiKeyAqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-barber.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-barber
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-barber.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# PIN de respaldo para el Panel de Administración en modo local sin Firebase:
VITE_ADMIN_FALLBACK_PIN=1234
